{
  "schemaVersion": 1,
  "id": "golemdoctor",
  "version": "${version}",
  "name": "Golem Doctor",
  "description": "Point at a villager and see, in red, why it is not producing iron golems. The server works out the answer; the client shows it. One jar for both. Works in singleplayer and multiplayer, and the server does not need clients to have the mod.",
  "authors": ["Kishku7"],
  "contact": {
    "homepage": "https://github.com/Kishku7/GolemDoctor",
    "sources": "https://github.com/Kishku7/GolemDoctor",
    "issues": "https://github.com/Kishku7/mod_support/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/golemdoctor/icon.png",
  "environment": "*",
  "mixins": ["golemdoctor.mixins.json"],
  "entrypoints": {
    "main": ["com.kishku7.golemdoctor.GolemDoctorFabric"],
    "client": ["com.kishku7.golemdoctor.client.GolemDoctorFabricClient"]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": [">=${mcLower}", "<${mcUpper}"],
    "fabric-api": ">=${apiMin}"
  }
}
